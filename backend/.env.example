# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Supabase PostgreSQL & Auth Credentials
# (Can be left blank or set to 'demo' to run in Built-in High-Fidelity Academic Demo Mode)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-private-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Database Direct Connection (Optional for direct PostgreSQL operations)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Security & Admin Bootstrap
ADMIN_BOOTSTRAP_SECRET=super-secret-academic-admin-key-2026
JWT_SECRET=rto-smartqueue-academic-jwt-secret-key-35619
